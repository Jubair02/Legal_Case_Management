generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------------------------------------------------------------------------
 * Domain enums.
 *
 * These were plain Strings with the allowed values written in a trailing
 * comment, which meant the database itself would accept any text — a typo in
 * a migration or a direct SQL fix could silently create an unreachable case.
 * Postgres enforces them now. (Payment.paymentMethod stays a String: its
 * values are display labels such as "Bank Transfer" and "bKash".)
 * ------------------------------------------------------------------------ */

enum Role {
  ADMIN
  LAWYER
  CLIENT
  STAFF
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
}

enum CaseStatus {
  DRAFT
  ACTIVE
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HearingStatus {
  UPCOMING
  COMPLETED
  ADJOURNED
  POSTPONED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  INFO
  HEARING
  CASE
  BILLING
  SYSTEM
}

enum OutboundChannel {
  SMS
  EMAIL
}

enum OutboundStatus {
  PENDING
  SENT
  SIMULATED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  password      String
  role          Role           @default(CLIENT)
  status        AccountStatus  @default(ACTIVE)
  // Incremented whenever the password changes; JWTs carry the value they were
  // issued with and are rejected when it no longer matches (session revocation).
  sessionVersion Int            @default(0)
  lawyerProfile Lawyer?
  clientProfile Client?
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Lawyer {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  name           String
  phone          String?
  email          String?
  barCouncilId   String?
  specialization String?
  chamberName    String?
  experience     Int      @default(0)
  status         AccountStatus @default(ACTIVE)
  cases          Case[]   @relation("CaseLawyer")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Client {
  id         String    @id @default(cuid())
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id])
  name       String
  phone      String?
  email      String?
  nid        String?
  address    String?
  clientType ClientType @default(INDIVIDUAL)
  cases      Case[]
  invoices   Invoice[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Case {
  id                String         @id @default(cuid())
  caseNumber        String         @unique
  title             String
  type              String
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  lawyerId          String?
  lawyer            Lawyer?        @relation("CaseLawyer", fields: [lawyerId], references: [id])
  court             String
  district          String?
  filingDate        DateTime?
  status            CaseStatus     @default(ACTIVE)
  priority          CasePriority   @default(MEDIUM)
  oppositeParty     String?
  description       String?
  resolutionSummary String?
  outcome           String?
  closedAt          DateTime?
  documents         CaseDocument[]
  hearings          Hearing[]
  invoices          Invoice[]
  updates           CaseUpdate[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([clientId])
  @@index([lawyerId])
}

model CaseDocument {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id])
  documentName     String
  documentType     String?
  category         String? // Legal Documents | Client Documents | Court Orders | Evidence
  fileName         String?
  filePath         String?
  fileSize         Int?
  mimeType         String?
  sharedWithClient Boolean  @default(false)
  uploadedById     String?
  uploadedByName   String?
  createdAt        DateTime @default(now())

  @@index([caseId])
}

model Hearing {
  id              String    @id @default(cuid())
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id])
  hearingDate     DateTime
  court           String?
  judge           String?
  hearingType     String?
  status          HearingStatus @default(UPCOMING)
  notes           String?
  summary         String?
  courtOrder      String?
  nextAction      String?
  nextHearingDate DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([caseId])
  @@index([hearingDate])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  caseId        String?
  case          Case?     @relation(fields: [caseId], references: [id])
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  billingType   String?
  description   String?
  /// Money is exact: binary floats cannot represent 0.10 and drift on sums.
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       DateTime?
  status        InvoiceStatus @default(UNPAID)
  payments      Payment[]
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([caseId])
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String // Cash | Bank Transfer | bKash | Nagad | Rocket
  paymentDate     DateTime @default(now())
  referenceNumber String?
  notes           String?
  receivedById    String?
  receivedByName  String?
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

model CaseUpdate {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  update         String
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@index([caseId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String?
  type      NotificationType @default(INFO)
  link      String? // e.g. "case-detail:<caseId>"
  caseId    String?
  dedupeKey String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([dedupeKey])
}

/**
 * SMS/Email delivery queue. Every outbound message is enqueued here first and
 * then dispatched through the provider bridge (lib/outbound.ts). When no
 * provider credentials are configured the bridge marks messages SIMULATED so
 * chambers can preview the exact wording in the outbox before going live.
 */
model OutboundMessage {
  id            String    @id @default(cuid())
  channel       OutboundChannel
  recipient     String // phone number or email address
  recipientName String?
  userId        String? // linked portal user, when known
  event         String // HEARING_TODAY | HEARING_TOMORROW | HEARING_SCHEDULED | HEARING_UPDATED | INVOICE_ISSUED | INVOICE_OVERDUE | PAYMENT_RECEIVED | TEST
  body          String
  caseId        String?
  caseNumber    String? // denormalised snapshot for the outbox list
  status        OutboundStatus @default(PENDING)
  providerRef   String?
  error         String?
  attempts      Int       @default(0)
  sentAt        DateTime?
  dedupeKey     String?   @unique
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([event])
}

/**
 * Monotonic counters for human-facing document numbers (key = "INV-2026").
 *
 * Neither counting rows nor taking max() is safe: delete the newest invoice
 * and both go backwards, so the next one reuses a number that a client may
 * already have on paper. This only ever increments.
 */
model NumberSequence {
  key   String @id
  value Int    @default(0)
}

/**
 * Failed sign-in buckets for brute-force protection.
 *
 * Kept in the database rather than process memory so the limit holds across
 * every instance behind a load balancer — an in-memory Map would let an
 * attacker get N attempts per replica. Rows are pruned by the scheduler sweep.
 */
model LoginAttempt {
  key          String    @id
  count        Int       @default(0)
  firstAt      DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

/** Single-row-per-key app settings (JSON encoded). Key "outbound" drives the SMS/Email bridge. */
model SystemSetting {
  key       String   @id
  value     String // JSON string
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/** Append-only audit trail of every business mutation and auth event. */
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String?
  actorRole   String?
  action      String // CASE_CREATE, HEARING_UPDATE, PAYMENT_RECORD, AUTH_LOGIN, ...
  entityType  String // Case | Hearing | Invoice | Payment | Client | Lawyer | User | Document | Auth | Settings
  entityId    String?
  entityLabel String? // human-readable snapshot (case number, invoice number, ...)
  summary     String? // short human sentence
  meta        String? // JSON string with { field: { from, to } } diffs
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([entityType, entityId])
}
